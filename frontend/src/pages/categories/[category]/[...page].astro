---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../../lib/schema';
import { sortByUpdated } from '../../../lib/tools';
import { getReservedSlugs } from '../../../lib/tag-filter';
import { slugify } from '../../../lib/slug';
import { PAGE_SIZE, MIN_INDEXABLE_LISTINGS } from '../../../lib/config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import Pagination from '../../../components/Pagination.astro';

export const getStaticPaths = (async ({ paginate }) => {
	const tools = await getCollection('tools');
	const categories = await getCollection('categories');
	const reservedSlugs = getReservedSlugs(tools);
	return CATEGORIES.flatMap((category) => {
		const list = tools.filter((tool) => tool.data.category === category);
		if (list.length === 0) return [];
		const slug = slugify(category);
		const description = categories.find((entry) => entry.id === slug)?.data.description;
		return paginate(sortByUpdated(list), {
			params: { category: slug },
			props: { category, description, reservedSlugs },
			pageSize: PAGE_SIZE,
		});
	});
}) satisfies GetStaticPaths;

const { page, category, description, reservedSlugs } = Astro.props;
---

<BaseLayout
	title={`${category} — The Terminal Index`}
	command={`ls categories/${slugify(category)}`}
	description={description}
	backHref="/categories"
	editHref={`/categories/${slugify(category)}/edit`}
	noindex={page.total < MIN_INDEXABLE_LISTINGS}
	breadcrumb={[{ label: `${slugify(category)}/` }]}
>
	<header class="hero">
		<h1>{category}</h1>
		{description && <p class="entity-description">{description}</p>}
		<p class="tagline"># {page.total} tool{page.total === 1 ? '' : 's'} in this category</p>
	</header>

	<ul id="tool-grid">{page.data.map((tool) => <ToolCard tool={tool} reservedSlugs={reservedSlugs} />)}</ul>

	<Pagination page={page} />
</BaseLayout>
