---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../../lib/schema';
import { sortForListing } from '../../../lib/tools';
import { getReservedSlugs } from '../../../lib/tag-filter';
import { slugify } from '../../../lib/slug';
import { PAGE_SIZE, MIN_INDEXABLE_LISTINGS } from '../../../lib/config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import ToolCard from '../../../components/ToolCard.astro';
import Pagination from '../../../components/Pagination.astro';
import TileIcon from '../../../components/TileIcon.astro';
import { itemListLd, pageTitle, pagedDescription, sampleNames } from '../../../lib/seo';

export const getStaticPaths = (async ({ paginate }) => {
	const tools = await getCollection('tools');
	const categories = await getCollection('categories');
	const reservedSlugs = getReservedSlugs(tools);
	return CATEGORIES.flatMap((category) => {
		const list = tools.filter((tool) => tool.data.category === category);
		if (list.length === 0) return [];
		const slug = slugify(category);
		const description = categories.find((entry) => entry.id === slug)?.data.description;
		return paginate(sortForListing(list), {
			params: { category: slug },
			props: { category, description, reservedSlugs },
			pageSize: PAGE_SIZE,
		});
	});
}) satisfies GetStaticPaths;

const { page, category, description, reservedSlugs } = Astro.props;
const metaDescription = pagedDescription(
	description ?? `${page.total} ${category} command-line tools, including ${sampleNames(page.data)}.`,
	page.currentPage,
	page.lastPage,
);
---

<BaseLayout
	title={pageTitle(`${category} CLI Tools`, page.currentPage)}
	description={metaDescription}
	jsonLd={[itemListLd(page.data, page.start)]}
	editHref={`/categories/${slugify(category)}/edit/`}
	noindex={page.total < MIN_INDEXABLE_LISTINGS}
	breadcrumb={[{ label: 'Categories', href: '/categories/' }, { label: category }]}
>
	<header class="page-head tile-hero">
		<TileIcon kind="category" slug={slugify(category)} size={88} />
		<div>
			<h1>{category}</h1>
			{description && <p class="entity-description">{description}</p>}
			<p class="tagline">{page.total} tool{page.total === 1 ? '' : 's'} in this category</p>
		</div>
	</header>

	<div class="browse-layout">
		<CategoryNav current={category} />
		<div>
			<ul id="tool-grid">{page.data.map((tool) => <ToolCard tool={tool} reservedSlugs={reservedSlugs} />)}</ul>
			<Pagination page={page} />
		</div>
	</div>
</BaseLayout>
