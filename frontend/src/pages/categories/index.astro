---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../lib/schema';
import { slugify } from '../../lib/slug';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle } from '../../lib/seo';
import TileIcon from '../../components/TileIcon.astro';

const tools = await getCollection('tools');
const descriptions = new Map((await getCollection('categories')).map((entry) => [entry.id, entry.data.description]));
const counts = new Map<string, number>();
for (const tool of tools) {
	counts.set(tool.data.category, (counts.get(tool.data.category) ?? 0) + 1);
}
const nonEmptyCategories = CATEGORIES.filter((category) => (counts.get(category) ?? 0) > 0).sort((a, b) =>
	a.localeCompare(b),
);
---

<BaseLayout
	title={pageTitle('Browse CLI Tools by Category')}
	description={`Browse ${tools.length} terminal tools across ${nonEmptyCategories.length} categories: ${nonEmptyCategories.slice(0, 5).join(', ')} and more.`}
	breadcrumb={[{ label: 'Categories' }]}
>
	<header class="page-head">
		<h1>Categories</h1>
		<p class="tagline">Every tool has one main category. Pick the job you need done.</p>
	</header>

	<ul class="dir-grid tile-grid">
		{
			nonEmptyCategories.map((category) => (
				<li>
					<a href={`/categories/${slugify(category)}/`}>
						<TileIcon kind="category" slug={slugify(category)} />
						<span class="tile-text">
							<span class="dir-head">
								<span class="dir-name">{category}</span>
								<span class="count">{counts.get(category)}</span>
							</span>
							{descriptions.get(slugify(category)) && (
								<span class="dir-desc" title={descriptions.get(slugify(category))}>{descriptions.get(slugify(category))}</span>
							)}
						</span>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
