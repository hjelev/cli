---
import { getCollection } from 'astro:content';
import { slugify } from '../../lib/slug';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageTile from '../../components/LanguageTile.astro';
import { pageTitle } from '../../lib/seo';

const tools = await getCollection('tools');
const descriptions = new Map((await getCollection('languages')).map((entry) => [entry.id, entry.data.description]));
// Group by slug so languages that collide (see languages/[language]/[...page].astro)
// get one entry whose count matches the page it links to.
const bySlug = new Map<string, { label: string; toolIds: Set<string> }>();
for (const tool of tools) {
	const slug = slugify(tool.data.language);
	const entry = bySlug.get(slug) ?? { label: tool.data.language, toolIds: new Set<string>() };
	if (!entry.label.split(' / ').includes(tool.data.language)) entry.label += ` / ${tool.data.language}`;
	entry.toolIds.add(tool.id);
	bySlug.set(slug, entry);
}
const languages = [...bySlug.entries()]
	.map(([slug, { label, toolIds }]) => ({ slug, label, count: toolIds.size }))
	// Biggest languages first, matching /categories; slug as a stable tiebreak.
	.sort((a, b) => b.count - a.count || a.slug.localeCompare(b.slug));
---

<BaseLayout
	title={pageTitle('Browse CLI Tools by Language')}
	description={`Browse ${tools.length} terminal tools by the language they're written in: ${languages
		.slice(0, 5)
		.map((l) => l.label)
		.join(', ')} and more.`}
	breadcrumb={[{ label: 'Languages' }]}
>
	<header class="page-head">
		<h1>Languages</h1>
		<p class="tagline">The languages these tools are written in, most common first.</p>
	</header>

	<ul class="dir-grid tile-grid">
		{
			languages.map(({ slug, label, count }) => (
				<li>
					<a href={`/languages/${slug}/`}>
						<LanguageTile language={label} />
						<span class="tile-text">
							<span class="dir-head">
								<span class="dir-name">{label}</span>
								<span class="count">{count}</span>
							</span>
							{descriptions.get(slug) && <span class="dir-desc" title={descriptions.get(slug)}>{descriptions.get(slug)}</span>}
						</span>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
