---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { sortForListing } from '../../../lib/tools';
import { getReservedSlugs } from '../../../lib/tag-filter';
import { slugify } from '../../../lib/slug';
import { PAGE_SIZE, MIN_INDEXABLE_LISTINGS } from '../../../lib/config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { itemListLd, pageTitle, pagedDescription, sampleNames } from '../../../lib/seo';
import LanguageTile from '../../../components/LanguageTile.astro';

export const getStaticPaths = (async ({ paginate }) => {
	const tools = await getCollection('tools');
	const languageEntries = await getCollection('languages');
	const reservedSlugs = getReservedSlugs(tools);
	// Distinct language names can share a slug, so group by slug: one page (set)
	// per slug, listing every tool whose language maps to it.
	const languagesBySlug = new Map<string, string[]>();
	for (const tool of tools) {
		const slug = slugify(tool.data.language);
		const languages = languagesBySlug.get(slug) ?? [];
		if (!languages.includes(tool.data.language)) languages.push(tool.data.language);
		languagesBySlug.set(slug, languages);
	}
	return [...languagesBySlug.entries()].flatMap(([slug, languages]) => {
		const description = languageEntries.find((entry) => entry.id === slug)?.data.description;
		return paginate(
			sortForListing(tools.filter((tool) => slugify(tool.data.language) === slug)),
			{
				params: { language: slug },
				props: { language: languages.join(' / '), description, reservedSlugs },
				pageSize: PAGE_SIZE,
			},
		);
	});
}) satisfies GetStaticPaths;

const { page, language, description, reservedSlugs } = Astro.props;
---

<BaseLayout
	title={pageTitle(`CLI Tools Written in ${language}`, page.currentPage)}
	description={pagedDescription(
		description ?? `${page.total} command-line tools written in ${language}, including ${sampleNames(page.data)}.`,
		page.currentPage,
		page.lastPage,
	)}
	jsonLd={[itemListLd(page.data, page.start)]}
	editHref={`/languages/${slugify(language)}/edit/`}
	noindex={page.total < MIN_INDEXABLE_LISTINGS}
	breadcrumb={[{ label: 'Languages', href: '/languages/' }, { label: language }]}
>
	<header class="page-head tile-hero">
		<LanguageTile language={language} size={88} />
		<div>
			<h1>{language}</h1>
			{description && <p class="entity-description">{description}</p>}
			<p class="tagline">{page.total} tool{page.total === 1 ? '' : 's'} written in {language}</p>
		</div>
	</header>

	<ul id="tool-grid">{page.data.map((tool) => <ToolCard tool={tool} reservedSlugs={reservedSlugs} />)}</ul>

	<Pagination page={page} />
</BaseLayout>
