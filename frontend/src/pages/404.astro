---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404: not found — The Terminal Index" narrow noindex={true}>
	<header class="page-head">
		<h1>Page not found</h1>
		<p class="tagline">Nothing lives at this address. The tool may have been renamed or removed from the index.</p>
	</header>

	<pre class="code"><code><span class="prompt" aria-hidden="true">$ </span>cd <span class="requested-path">/404</span>
cd: no such file or directory: <span class="requested-path">/404</span></code></pre>

	<nav class="guide-links not-found-links">
		<a href="/">Browse all tools</a>
		<a href="/categories/">Browse by category</a>
		<a href="/submit/">Submit a tool</a>
	</nav>

	<script>
		const path = window.location.pathname;
		if (path && path !== '/404' && path !== '/404.html') {
			for (const el of document.querySelectorAll('.requested-path')) {
				el.textContent = path;
			}
		}
	</script>
</BaseLayout>
