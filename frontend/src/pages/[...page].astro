---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../lib/schema';
import { getSortedTools, sortByUpdated } from '../lib/tools';
import { getReservedSlugs } from '../lib/tag-filter';
import { PAGE_SIZE, MAX_CARD_TAGS } from '../lib/config';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryNav from '../components/CategoryNav.astro';
import ToolCard from '../components/ToolCard.astro';
import Pagination from '../components/Pagination.astro';
import { SITE_NAME, itemListLd, pagedDescription, websiteLd } from '../lib/seo';

export const getStaticPaths = (async ({ paginate }) => {
	const tools = await getSortedTools();
	return paginate(tools, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// The <select> options are built from the FULL collection so filtering works
// across every page, not just this page's slice. The search index itself lives
// at /api/search-index.json and is fetched only when the user starts searching.
const allTools = sortByUpdated(await getCollection('tools'));
const languages = [...new Set(allTools.map((tool) => tool.data.language))].sort();
const usedCategories = new Set(allTools.map((tool) => tool.data.category));
const categories = CATEGORIES.filter((category) => usedCategories.has(category)).sort((a, b) => a.localeCompare(b));
const reservedSlugs = getReservedSlugs(allTools);

const countLabel =
	page.lastPage > 1 ? `${page.total} tools, page ${page.currentPage} of ${page.lastPage}` : `${page.total} tools`;

// The hero's logo wall: the most-starred tools that have a logo.
const WALL_SIZE = 25;
const wall = allTools
	.filter((tool) => tool.data.logo)
	.sort((a, b) => (b.data.repo_stars ?? 0) - (a.data.repo_stars ?? 0))
	.slice(0, WALL_SIZE);

const siteDescription = `Discover ${page.total} terminal tools, curated by the developers who rely on them. Browse open-source CLI and TUI apps by category, language and tag.`;
const title = page.currentPage > 1 ? `${SITE_NAME} — Page ${page.currentPage}` : `${SITE_NAME} — Curated CLI & TUI Tools`;
---

<BaseLayout
	title={title}
	description={pagedDescription(siteDescription, page.currentPage, page.lastPage)}
	jsonLd={[...(page.currentPage === 1 ? [websiteLd(siteDescription)] : []), itemListLd(page.data, page.start)]}
>
	<section class="hero" slot="hero">
		<div class="hero-inner">
			<div class="hero-text">
				<h1>Find your next terminal tool</h1>
				<p>
					{page.total} open-source CLI and TUI apps in {usedCategories.size} categories, curated by the developers who rely on them.
				</p>
				<label class="search-field">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m20 20-4-4"></path>
					</svg>
					<input id="search" type="search" placeholder="Search by name, task or tag" aria-label="Search tools" />
					<kbd class="search-key" title="Press / to search">/</kbd>
				</label>
			</div>
			<!-- A pointer shortcut into popular tools; the same pages are all reachable from the list below. -->
			<ul class="logo-wall" aria-hidden="true">
				{wall.map((tool) => (
					<li>
						<a href={`/tools/${tool.id}/`} title={tool.data.name} tabindex="-1">
							<img src={tool.data.logo} alt="" width="56" height="56" loading="lazy" decoding="async" />
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div class="browse-layout">
	<CategoryNav />

	<div>
	<section id="filters" class="filters">
		<p class="result-count" data-status role="status">{countLabel}</p>

		<button type="button" id="filters-toggle" class="filters-toggle" aria-expanded="false" aria-controls="filter-selects">
			Filters<span class="filters-count"></span>
		</button>

		<div id="filter-selects" class="filter-selects">
			<select id="category-filter" aria-label="Category">
				<option value="">All categories</option>
				{categories.map((category) => <option value={category}>{category}</option>)}
			</select>

			<select id="language-filter" aria-label="Language">
				<option value="">All languages</option>
				{languages.map((language) => <option value={language}>{language}</option>)}
			</select>

			<select id="sort-filter" aria-label="Sort order">
				<option value="">Recently updated</option>
				<option value="stars">Most stars</option>
				<option value="trending">Trending (2 weeks)</option>
				<option value="verified">Verified only</option>
			</select>
		</div>
	</section>

	<p id="empty-state" hidden>No tools match. Try a shorter search, or choose all categories and languages.</p>

	<ul id="tool-grid">
		{page.data.map((tool) => <ToolCard tool={tool} reservedSlugs={reservedSlugs} />)}
	</ul>

	<!-- Populated by the search script when a filter is active; hidden otherwise. -->
	<ul id="search-results" hidden></ul>

	<Pagination page={page} />
	</div>
	</div>

	<script type="application/json" id="card-config" set:html={JSON.stringify({ maxTags: MAX_CARD_TAGS })} />

	<script>
		import { formatAge } from '../lib/repo-age';
		import { VERIFIED_TITLE } from '../lib/badge';
		import { RECENT_STARS_TITLE, formatRecentStars } from '../lib/trending';

		interface ToolIndexEntry {
			id: string;
			name: string;
			short: string;
			category: string;
			language: string;
			tags: string[];
			logo: string | null;
			stars: number | null;
			recent: number | null;
			created: string | null;
			verified: boolean;
			search: string;
		}

		const search = document.getElementById('search') as HTMLInputElement;
		const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
		const languageFilter = document.getElementById('language-filter') as HTMLSelectElement;
		const sortFilter = document.getElementById('sort-filter') as HTMLSelectElement;
		const categoryLinks = document.querySelectorAll<HTMLAnchorElement>('.category-nav a');
		const categoryCounts = [...categoryLinks].map((link) => {
			const el = link.querySelector('.count') as HTMLElement;
			return { link, el, category: link.dataset.category ?? '', total: el.textContent ?? '' };
		});
		const filtersSection = document.getElementById('filters') as HTMLElement;
		const filtersToggle = document.getElementById('filters-toggle') as HTMLButtonElement;
		const filtersCount = filtersToggle.querySelector('.filters-count') as HTMLElement;
		const statusSeg = document.querySelector<HTMLElement>('[data-status]');
		const defaultStatus = statusSeg?.textContent ?? '';
		const grid = document.getElementById('tool-grid') as HTMLUListElement;
		const results = document.getElementById('search-results') as HTMLUListElement;
		const pagination = document.querySelector('.pagination') as HTMLElement | null;
		const emptyState = document.getElementById('empty-state') as HTMLElement;
		// The full index is only downloaded once the user engages with search or
		// filters (click, tap or focus), so plain browsing stays lightweight.
		let tools: ToolIndexEntry[] | null = null;
		let toolsPromise: Promise<ToolIndexEntry[]> | null = null;
		function loadTools(): Promise<ToolIndexEntry[]> {
			toolsPromise ??= fetch('/api/search-index.json')
				.then((res) => {
					if (!res.ok) throw new Error(`search index: HTTP ${res.status}`);
					return res.json() as Promise<ToolIndexEntry[]>;
				})
				.then((data) => (tools = data))
				.catch((error) => {
					toolsPromise = null; // allow a retry on the next interaction
					throw error;
				});
			return toolsPromise;
		}
		const { maxTags } = JSON.parse(
			(document.getElementById('card-config') as HTMLScriptElement).textContent!,
		) as { maxTags: number };
		const compactNumber = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });

		function span(className: string, text: string, title?: string): HTMLSpanElement {
			const el = document.createElement('span');
			if (className) el.className = className;
			el.textContent = text;
			if (title) el.title = title;
			return el;
		}

		// keep in sync with ToolCard.astro — builds the same markup from the search index.
		function renderCard(tool: ToolIndexEntry): HTMLLIElement {
			const li = document.createElement('li');
			li.className = 'tool-card';
			li.dataset.category = tool.category;
			li.dataset.language = tool.language;

			const a = document.createElement('a');
			a.href = `/tools/${tool.id}/`;

			if (tool.logo) {
				const img = document.createElement('img');
				img.className = 'tool-logo';
				img.src = tool.logo;
				img.alt = '';
				img.width = 52;
				img.height = 52;
				img.loading = 'lazy';
				a.append(img);
			} else {
				const monogram = span('tool-logo', tool.name.slice(0, 1));
				monogram.ariaHidden = 'true';
				a.append(monogram);
			}

			const text = document.createElement('div');
			text.className = 'tool-text';

			const name = document.createElement('div');
			name.className = 'tool-name';
			const h2 = document.createElement('h2');
			h2.textContent = tool.name;
			name.append(h2);
			if (tool.verified) name.append(span('badge-verified', '✓ verified', VERIFIED_TITLE));

			const desc = document.createElement('p');
			desc.textContent = tool.short;

			const meta = document.createElement('div');
			meta.className = 'tool-meta';
			meta.append(span('', tool.language), span('', tool.category));
			if (tool.created) meta.append(span('', formatAge(tool.created), `Created ${tool.created.slice(0, 10)}`));

			const tags = document.createElement('ul');
			tags.className = 'tags';
			for (const tag of tool.tags.slice(0, maxTags)) {
				const tagLi = document.createElement('li');
				tagLi.textContent = tag;
				tags.append(tagLi);
			}
			if (tool.tags.length > maxTags) {
				const moreLi = document.createElement('li');
				moreLi.className = 'more';
				moreLi.textContent = `+${tool.tags.length - maxTags}`;
				tags.append(moreLi);
			}
			meta.append(tags);

			text.append(name, desc, meta);
			a.append(text);

			if (tool.stars !== null) {
				const stats = document.createElement('div');
				stats.className = 'tool-stats';
				stats.append(span('badge-stars', `★ ${compactNumber.format(tool.stars)}`, `${tool.stars} stars`));
				if (tool.recent) stats.append(span('badge-trending', formatRecentStars(tool.recent), RECENT_STARS_TITLE(tool.recent)));
				a.append(stats);
			}

			li.append(a);
			return li;
		}

		// Mirror the filter state into the query string so results are shareable
		// and survive Back. replaceState: typing shouldn't flood the history.
		function syncUrl() {
			const params = new URLSearchParams();
			if (search.value.trim()) params.set('q', search.value.trim());
			if (categoryFilter.value) params.set('category', categoryFilter.value);
			if (languageFilter.value) params.set('language', languageFilter.value);
			if (sortFilter.value) params.set('sort', sortFilter.value);
			const qs = params.toString();
			history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
		}

		function restoreFromUrl() {
			const params = new URLSearchParams(location.search);
			search.value = params.get('q') ?? '';
			// Assigning an unknown value to a <select> leaves it with no selection, so fall back to "All".
			for (const [select, key] of [
				[categoryFilter, 'category'],
				[languageFilter, 'language'],
				[sortFilter, 'sort'],
			] as const) {
				select.value = params.get(key) ?? '';
				if (select.selectedIndex === -1) select.value = '';
			}
		}

		// Higher is better: exact name > name prefix > name word > name substring > tag > description.
		function relevance(tool: ToolIndexEntry, query: string): number {
			const name = tool.name.toLowerCase();
			if (name === query) return 6;
			if (name.startsWith(query)) return 5;
			if (name.split(/[\s\-_.]+/).some((word) => word.startsWith(query))) return 4;
			if (name.includes(query)) return 3;
			const tags = tool.tags.map((tag) => tag.toLowerCase());
			if (tags.includes(query)) return 2;
			if (tags.some((tag) => tag.includes(query))) return 1;
			return 0;
		}

		// Sidebar counts: what each category would show with the search and the other
		// filters applied. Null restores the built-in totals.
		function updateCategoryCounts(candidates: ToolIndexEntry[] | null) {
			const counts = new Map<string, number>();
			for (const tool of candidates ?? []) counts.set(tool.category, (counts.get(tool.category) ?? 0) + 1);
			for (const { link, el, category, total } of categoryCounts) {
				const count = category ? (counts.get(category) ?? 0) : (candidates?.length ?? 0);
				el.textContent = candidates ? String(count) : total;
				link.classList.toggle('empty', candidates !== null && count === 0);
			}
		}

		// Bumped on every call so a slow index download can't apply stale filters.
		let filterRun = 0;
		async function applyFilters() {
			const run = ++filterRun;
			const query = search.value.trim().toLowerCase();
			const category = categoryFilter.value;
			const language = languageFilter.value;
			const sortByStars = sortFilter.value === 'stars';
			const sortByTrending = sortFilter.value === 'trending';
			const verifiedOnly = sortFilter.value === 'verified';
			const filtering = query !== '' || category !== '' || language !== '' || sortFilter.value !== '';

			syncUrl();
			updateFiltersCount();
			for (const link of categoryLinks) {
				if ((link.dataset.category ?? '') === category) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			}

			if (!filtering) {
				updateCategoryCounts(null);
				// Default paginated browsing: show this page's static grid + nav.
				grid.hidden = false;
				if (pagination) pagination.hidden = false;
				results.hidden = true;
				results.replaceChildren();
				emptyState.hidden = true;
				if (statusSeg) statusSeg.textContent = defaultStatus;
				return;
			}

			// Active filter: search across ALL tools, ignoring pagination.
			if (!tools) {
				if (statusSeg) statusSeg.textContent = 'Searching…';
				try {
					await loadTools();
				} catch {
					if (run === filterRun && statusSeg) statusSeg.textContent = 'Search couldn’t load. Check your connection and try again.';
					return;
				}
				// A newer call has taken over (or will, once the index lands).
				if (run !== filterRun) return;
			}

			// Everything but the category filter, so the sidebar can count the other categories too.
			const candidates = tools!.filter((tool) => {
				const matchesQuery = !query || tool.search.includes(query);
				const matchesLanguage = !language || tool.language === language;
				const matchesVerified = !verifiedOnly || tool.verified;
				return matchesQuery && matchesLanguage && matchesVerified;
			});
			updateCategoryCounts(candidates);
			const matches = candidates.filter((tool) => !category || tool.category === category);
			// The index is already in recently-updated order; stars/trending need a re-sort
			// (trending ties fall back to total stars).
			// With a query, rank by relevance first; the stable sort keeps the chosen order within a tier.
			if (sortByStars) matches.sort((a, b) => (b.stars ?? -1) - (a.stars ?? -1));
			if (sortByTrending) matches.sort((a, b) => (b.recent ?? -1) - (a.recent ?? -1) || (b.stars ?? -1) - (a.stars ?? -1));
			if (query) matches.sort((a, b) => relevance(b, query) - relevance(a, query));

			results.replaceChildren(...matches.map(renderCard));
			grid.hidden = true;
			if (pagination) pagination.hidden = true;
			results.hidden = false;
			emptyState.hidden = matches.length > 0;
			if (statusSeg) statusSeg.textContent = `${matches.length} matching tool${matches.length === 1 ? '' : 's'}`;
		}

		// Small screens fold the selects behind a toggle; it shows how many are set.
		function setFiltersOpen(open: boolean) {
			filtersSection.classList.toggle('open', open);
			filtersToggle.setAttribute('aria-expanded', String(open));
		}

		function updateFiltersCount() {
			const active = [categoryFilter, languageFilter, sortFilter].filter((select) => select.value).length;
			filtersCount.textContent = active ? ` (${active})` : '';
		}

		filtersToggle.addEventListener('click', () => setFiltersOpen(!filtersSection.classList.contains('open')));

		// Start the download as soon as the user reaches for search or filters.
		const prefetch = () => void loadTools().catch(() => {});
		for (const el of [search, categoryFilter, languageFilter, sortFilter, filtersToggle]) {
			for (const type of ['focus', 'pointerdown'] as const) {
				el.addEventListener(type, prefetch, { once: true, passive: true });
			}
		}

		search.addEventListener('input', applyFilters);
		categoryFilter.addEventListener('change', applyFilters);
		languageFilter.addEventListener('change', applyFilters);
		sortFilter.addEventListener('change', applyFilters);

		// Sidebar categories filter in place, so they combine with the search and
		// the other filters. Modified clicks still open the category's own page.
		for (const link of categoryLinks) {
			link.addEventListener('pointerdown', prefetch, { once: true, passive: true });
			link.addEventListener('click', (event) => {
				if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
				event.preventDefault();
				categoryFilter.value = link.dataset.category ?? '';
				applyFilters();
			});
		}

		restoreFromUrl();
		if (location.search) applyFilters();
		if (categoryFilter.value || languageFilter.value || sortFilter.value) setFiltersOpen(true);
	</script>
</BaseLayout>
