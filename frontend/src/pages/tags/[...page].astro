---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { getReservedSlugs, groupTagsBySlug } from '../../lib/tag-filter';
import { MIN_INDEXABLE_LISTINGS, TAGS_INDEX_PAGE_SIZE } from '../../lib/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowseLinks from '../../components/BrowseLinks.astro';
import Pagination from '../../components/Pagination.astro';
import { pageTitle, pagedDescription } from '../../lib/seo';

export const getStaticPaths = (async ({ paginate }) => {
	const tools = await getCollection('tools');
	const reservedSlugs = getReservedSlugs(tools);
	// Only tags that have a page (see getIndexableTagSlugs) are listed.
	// Popularity-based pagination: most-used tags lead page 1, not alphabetical
	// or chronological order. Tie-break on slug for a stable order.
	const tags = [...groupTagsBySlug(tools, reservedSlugs).entries()]
		.map(([slug, { labels, toolIds }]) => ({ slug, label: labels.join(' / '), count: toolIds.size }))
		.filter((t) => t.count >= MIN_INDEXABLE_LISTINGS)
		.sort((a, b) => b.count - a.count || a.slug.localeCompare(b.slug));
	return paginate(tags, { pageSize: TAGS_INDEX_PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const status = page.lastPage > 1 ? `page ${page.currentPage}/${page.lastPage}` : undefined;
---

<BaseLayout
	title={pageTitle('Browse CLI Tools by Tag', page.currentPage)}
	description={pagedDescription(
		`Browse ${page.total} tags across the terminal tools in The Terminal Index — from ${page.data
			.slice(0, 4)
			.map((t) => t.label.split(' / ')[0])
			.join(', ')} to niche topics.`,
		page.currentPage,
		page.lastPage,
	)}
	command="ls tags/"
	backHref="/"
	status={status}
	breadcrumb={[{ label: 'tags/' }]}
>
	<header class="hero">
		<h1>Tags</h1>
		<p class="tagline"># browse tools by tag</p>
		<BrowseLinks current="tags" />
	</header>

	<ul class="links">
		{
			page.data.map(({ slug, label, count }) => (
				<li>
					<a href={`/tags/${slug}/`}>
						#{label} <span class="count">({count})</span>
					</a>
				</li>
			))
		}
	</ul>

	<Pagination page={page} />
</BaseLayout>
