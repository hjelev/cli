---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { sortForListing } from '../../../lib/tools';
import { getReservedSlugs, groupTagsBySlug } from '../../../lib/tag-filter';
import { slugify } from '../../../lib/slug';
import { PAGE_SIZE, MIN_INDEXABLE_LISTINGS } from '../../../lib/config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { itemListLd, pageTitle, pagedDescription, sampleNames } from '../../../lib/seo';

export const getStaticPaths = (async ({ paginate }) => {
	const tools = await getCollection('tools');
	const reservedSlugs = getReservedSlugs(tools);
	// One page (set) per tag slug, listing every tool whose tags map to it.
	// Tags below MIN_INDEXABLE_LISTINGS get no page at all (see
	// getIndexableTagSlugs), so every generated tag page is indexable.
	return [...groupTagsBySlug(tools, reservedSlugs).entries()]
		.filter(([, group]) => group.toolIds.size >= MIN_INDEXABLE_LISTINGS)
		.flatMap(([slug, group]) =>
			paginate(
				sortForListing(tools.filter((tool) => group.toolIds.has(tool.id))),
				{
					params: { tag: slug },
					props: { tag: group.labels.join(' / '), reservedSlugs },
					pageSize: PAGE_SIZE,
				},
			),
		);
}) satisfies GetStaticPaths;

const { page, tag, reservedSlugs } = Astro.props;
---

<BaseLayout
	title={pageTitle(`#${tag} CLI Tools`, page.currentPage)}
	description={pagedDescription(
		`${page.total} command-line tool${page.total === 1 ? '' : 's'} tagged ${tag}: ${sampleNames(page.data)}.`,
		page.currentPage,
		page.lastPage,
	)}
	jsonLd={[itemListLd(page.data, page.start)]}
	command={`ls tags/${slugify(tag)}`}
	backHref="/tags/"
	breadcrumb={[{ label: `${slugify(tag)}/` }]}
>
	<header class="hero">
		<h1>#{tag}</h1>
		<p class="tagline"># {page.total} tool{page.total === 1 ? '' : 's'} tagged {tag}</p>
	</header>

	<ul id="tool-grid">{page.data.map((tool) => <ToolCard tool={tool} reservedSlugs={reservedSlugs} />)}</ul>

	<Pagination page={page} />
</BaseLayout>
