---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface BreadcrumbSegment {
	label: string;
	href?: string;
}

interface Props {
	title: string;
	description?: string;
	editHref?: string;
	noindex?: boolean;
	breadcrumb?: BreadcrumbSegment[];
	// Forms and short messages read better in a narrow column.
	narrow?: boolean;
	// Share-card overrides; default to the site-wide card.
	ogImage?: string;
	ogType?: 'website' | 'article';
	// Schema.org objects emitted as JSON-LD (a BreadcrumbList is added automatically).
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description,
	editHref,
	noindex = false,
	breadcrumb = [],
	narrow = false,
	ogImage = '/og-image.png',
	ogType = 'website',
	jsonLd = [],
} = Astro.props;

const SECTIONS = [
	{ label: 'Categories', href: '/categories/' },
	{ label: 'Collections', href: '/collections/' },
	{ label: 'Alternatives', href: '/alternatives/' },
	{ label: 'Languages', href: '/languages/' },
	{ label: 'Tags', href: '/tags/' },
];

const path = Astro.url.pathname.replace(/\/*$/, '/');
// The home listing (and its numbered pages) has its own, larger search field.
const isHome = /^\/(\d+\/)?$/.test(path);

// Share-card metadata. Astro.site comes from astro.config `site`.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// Mirrors the visible breadcrumb; the last segment is the current page and needs no URL.
const breadcrumbLd = breadcrumb.length > 0 && {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [{ label: 'The Terminal Index', href: '/' }, ...breadcrumb].map((segment, i, all) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: segment.label,
		...(i < all.length - 1 && segment.href ? { item: new URL(segment.href, Astro.site).href } : {}),
	})),
};
// Escape `<` so content can never close the <script> element early.
const ldJson = [...jsonLd, breadcrumbLd]
	.filter(Boolean)
	.map((entry) => JSON.stringify(entry).replace(/</g, '\\u003c'));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e1714" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
		<link rel="alternate" type="application/rss+xml" title="The Terminal Index: new tools" href="/rss.xml" />
		{!noindex && <link rel="canonical" href={pageUrl} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="The Terminal Index" />
		<meta property="og:title" content={title} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:image" content={ogImageUrl} />
		{description && <meta property="og:description" content={description} />}
		{description && <meta name="twitter:description" content={description} />}
		{ldJson.map((json) => <script is:inline type="application/ld+json" set:html={json} />)}
		<script defer src="https://m.masoko.net/core-util" data-website-id="b005feb8-941a-4967-b499-0a0b5f2eff9e"></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="site-header-inner">
				<a class="site-brand" href="/"><Logo /><span>The Terminal Index</span></a>

				<nav class="site-nav" aria-label="Browse">
					{SECTIONS.map(({ label, href }) => (
						<a href={href} aria-current={path === href ? 'page' : path.startsWith(href) ? 'true' : undefined}>{label}</a>
					))}
				</nav>

				<div class="site-actions">
					{!isHome && (
						<form class="site-search" action="/" role="search">
							<input id="site-search" name="q" type="search" placeholder="Search tools" aria-label="Search tools" />
							<kbd class="search-key" title="Press / to search">/</kbd>
						</form>
					)}
					<a class="icon-link" href="https://github.com/hjelev/cli" target="_blank" rel="noopener" aria-label="GitHub repository">
						<svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
						</svg>
					</a>
					<a class="btn" href="/submit/" aria-current={path === '/submit/' ? 'page' : undefined} aria-label="Submit a tool">Submit<span class="btn-more">&nbsp;a tool</span></a>
				</div>
			</div>
		</header>

		<slot name="hero" />

		<main id="main" class:list={['page', { narrow }]}>
			{(breadcrumb.length > 0 || editHref) && (
				<div class="crumbs">
					<nav aria-label="Breadcrumb">
						<ol>
							<li><a href="/">Home</a></li>
							{breadcrumb.map((segment, i) => (
								<li>
									{i < breadcrumb.length - 1 && segment.href ? (
										<a href={segment.href}>{segment.label}</a>
									) : (
										<span aria-current="page">{segment.label}</span>
									)}
								</li>
							))}
						</ol>
					</nav>
					{editHref && <a class="edit-link" href={editHref}>Edit this page</a>}
				</div>
			)}
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer-inner">
				<p class="site-footer-about">
					<Logo />
					<span>An open, community-edited directory of CLI and TUI tools.</span>
				</p>
				<nav aria-label="Footer">
					<a href="https://github.com/hjelev/cli" target="_blank" rel="noopener">GitHub</a>
					<a href="/rss.xml">RSS feed</a>
					<a href="/api/tools.json">JSON API</a>
					<a href="/submit/">Submit a tool</a>
				</nav>
			</div>
		</footer>

		<script>
			// Press "/" to jump to the page's search field, Escape to leave it.
			const field = document.querySelector<HTMLInputElement>('#search, #site-search');
			document.addEventListener('keydown', (event) => {
				if (!field || event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey) return;
				const target = event.target as HTMLElement;
				if (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)) return;
				event.preventDefault();
				field.focus();
				field.select();
			});
			field?.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') field.blur();
			});
		</script>
	</body>
</html>
