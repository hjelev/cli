---
import type { CollectionEntry } from 'astro:content';
import { filterDisplayTags } from '../lib/tag-filter';

interface Props {
	tool: CollectionEntry<'tools'>;
	reservedSlugs: Set<string>;
}

const { tool, reservedSlugs } = Astro.props;

const repoStars = tool.data.repo_stars;
const repoStarsLabel =
	repoStars !== undefined
		? new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(repoStars)
		: null;

// Tags that just restate the tool's own category/language are noise — hide
// them here, but keep the full raw list in data-search below.
const displayTags = filterDisplayTags(tool.data.tags, reservedSlugs);
---

<li
	class="tool-card"
	data-category={tool.data.category}
	data-language={tool.data.language}
	data-search={`${tool.data.name} ${tool.data.short_description} ${tool.data.tags.join(' ')}`.toLowerCase()}
>
	<a href={`/tools/${tool.id}`}>
		<div class="tool-name">
			{tool.data.logo && <img src={tool.data.logo} alt={`${tool.data.name} logo`} width="44" height="44" />}
			<div class="tool-name-text">
				<h2>{tool.data.name}</h2>
				<span class="badge">{tool.data.language}</span>
			</div>
		</div>
		<p>{tool.data.short_description}</p>
		<div class="badges">
			{repoStarsLabel && (
				<span class="badge badge-stars" title={`${repoStars} stars`}>★ {repoStarsLabel}</span>
			)}
			<span class="badge">{tool.data.category}</span>
		</div>
		<ul class="tags">
			{displayTags.map((tag) => (
				<li>{tag}</li>
			))}
		</ul>
	</a>
</li>
