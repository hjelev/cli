---
import type { CollectionEntry } from 'astro:content';
import { filterDisplayTags } from '../lib/tag-filter';
import { formatAge } from '../lib/repo-age';
import { MAX_CARD_TAGS } from '../lib/config';
import { VERIFIED_TITLE } from '../lib/badge';
import { stripLeadingEmoji } from '../lib/text';
import { RECENT_STARS_TITLE, formatRecentStars } from '../lib/trending';

// Keep the markup in sync with renderCard() in pages/[...page].astro.
interface Props {
	tool: CollectionEntry<'tools'>;
	reservedSlugs: Set<string>;
}

const { tool, reservedSlugs } = Astro.props;

const repoStars = tool.data.repo_stars;
const repoStarsLabel =
	repoStars !== undefined
		? new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(repoStars)
		: null;
const recentStars = tool.data.repo_stars_recent;
const recentStarsLabel = repoStarsLabel && recentStars ? formatRecentStars(recentStars) : null;

// Tags that just restate the tool's own category/language are noise — hide
// them here, but keep the full raw list in data-search below.
const displayTags = filterDisplayTags(tool.data.tags, reservedSlugs);
const shownTags = displayTags.slice(0, MAX_CARD_TAGS);
const hiddenTagCount = displayTags.length - shownTags.length;
---

<li
	class="tool-card"
	data-category={tool.data.category}
	data-language={tool.data.language}
	data-search={`${tool.data.name} ${tool.data.short_description} ${tool.data.tags.join(' ')}`.toLowerCase()}
>
	<a href={`/tools/${tool.id}/`}>
		{tool.data.logo
			? <img class="tool-logo" src={tool.data.logo} alt="" width="52" height="52" loading="lazy" decoding="async" />
			: <span class="tool-logo" aria-hidden="true">{tool.data.name.slice(0, 1)}</span>}
		<div class="tool-text">
			<div class="tool-name">
				<h2>{tool.data.name}</h2>
				{tool.data.repo_badge && <span class="badge-verified" title={VERIFIED_TITLE}>✓ verified</span>}
			</div>
			<p>{stripLeadingEmoji(tool.data.short_description)}</p>
			<div class="tool-meta">
				<span>{tool.data.language}</span>
				<span>{tool.data.category}</span>
				{tool.data.repo_created && (
					<span title={`Created ${tool.data.repo_created.slice(0, 10)}`}>{formatAge(tool.data.repo_created)}</span>
				)}
				<ul class="tags">
					{shownTags.map((tag) => (
						<li>{tag}</li>
					))}
					{hiddenTagCount > 0 && <li class="more">+{hiddenTagCount}</li>}
				</ul>
			</div>
		</div>
		{repoStarsLabel && (
			<div class="tool-stats">
				<span class="badge-stars" title={`${repoStars} stars`}>★ {repoStarsLabel}</span>
				{recentStarsLabel && (
					<span class="badge-trending" title={RECENT_STARS_TITLE(recentStars!)}>{recentStarsLabel}</span>
				)}
			</div>
		)}
	</a>
</li>
